{$OMICSBASE_APP_HOST} {
    handle /omics-engine/* {
        @engine_status {
            method GET
            path_regexp ^/omics-engine/api/projects/[^/]+/status$
        }

        @engine_render {
            method POST
            path_regexp ^/omics-engine/api/projects/[^/]+/render$
        }

        @engine_site {
            method GET HEAD
            path_regexp ^/omics-engine/projects/[^/]+/_site(/.*)?$
        }

        @engine_runs {
            method GET HEAD
            path_regexp ^/omics-engine/projects/[^/]+/runs/[^/]+(/.*)?$
        }


        handle @engine_status {
            uri strip_prefix /omics-engine
            reverse_proxy 127.0.0.1:8001
        }

        handle @engine_render {
            uri strip_prefix /omics-engine
            reverse_proxy 127.0.0.1:8001
        }

        handle @engine_site {
            uri strip_prefix /omics-engine
            reverse_proxy 127.0.0.1:8001
        }

        # Note plots and tables come from the notes' engine on LUMI-K (fallback:
        # reverse_proxy 127.0.0.1:8001). Reports' sites stay on the VM engine.
        handle @engine_runs {
            uri strip_prefix /omics-engine
            reverse_proxy https://omicsbase-engine-omicsbase-utu.apps.lumi-k.eu {
                header_up Host {upstream_hostport}
            }
        }


        handle {
            respond "Not found" 404
        }
    }

    handle {
        reverse_proxy 127.0.0.1:3080
    }
}

{$OMICSBASE_WORKSPACE_HOST} {
    @internal path /api/omicsbase/revoke
    respond @internal 404
    reverse_proxy 127.0.0.1:3001
}

{$OMICSBASE_ADMIN_HOST} {
    reverse_proxy 127.0.0.1:3000
}
