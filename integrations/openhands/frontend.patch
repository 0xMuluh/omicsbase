diff --git a/frontend/src/integrations/omicsbase/policy.ts b/frontend/src/integrations/omicsbase/policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a1058ff4d3d193c25bf2ce97fa3d4afadd03da4
--- /dev/null
+++ b/frontend/src/integrations/omicsbase/policy.ts
@@ -0,0 +1,19 @@
+import type { ConversationTab } from "#/state/conversation-store";
+
+export function isEmbedded(): boolean {
+  return typeof window !== "undefined" &&
+    (window.self !== window.top || new URLSearchParams(window.location.search).get("embedded") === "true");
+}
+
+export function workspaceTab(value: ConversationTab | null): ConversationTab {
+  return value === "vscode" || value === "editor" ? value : "served";
+}
+
+export function parseStoredValue<T>(raw: string | null, fallback: T): T {
+  if (raw === null) return fallback;
+  try { return JSON.parse(raw) as T; } catch { return fallback; }
+}
+
+export function webHosts(hosts: string[] | Record<string, number>): string[] {
+  return Array.isArray(hosts) ? hosts : Object.keys(hosts);
+}
diff --git a/frontend/src/integrations/omicsbase/storage.ts b/frontend/src/integrations/omicsbase/storage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..605966b2e6a0d5ddff33ea75819f1ffbdb604f51
--- /dev/null
+++ b/frontend/src/integrations/omicsbase/storage.ts
@@ -0,0 +1,20 @@
+import { useCallback, useEffect, useState } from "react";
+import { parseStoredValue } from "./policy";
+
+export function useWorkspaceStorage<T>(key: string, fallback: T) {
+  const read = useCallback(() => {
+    try { return parseStoredValue(window.localStorage.getItem(key), fallback); }
+    catch { return fallback; }
+  }, [key, fallback]);
+  const [value, setValue] = useState<T>(read);
+  useEffect(() => {
+    const update = (event: StorageEvent) => { if (event.key === key) setValue(read()); };
+    window.addEventListener("storage", update);
+    return () => window.removeEventListener("storage", update);
+  }, [key, read]);
+  const write = useCallback((next: T) => {
+    setValue(next);
+    try { window.localStorage.setItem(key, JSON.stringify(next)); } catch { /* Storage may be disabled. */ }
+  }, [key]);
+  return [value, write] as const;
+}
