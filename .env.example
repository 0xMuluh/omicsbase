# LLM Configuration
LLM_PROVIDER=anthropic          # anthropic, openai, qwen, gemini, openrouter, orcarouter, groq, grok, xai, ollama
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DASHSCOPE_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...
ORCAROUTER_API_KEY=sk-orca-...
LLM_MODEL=gemini-3.6-flash   # or gemini-3.1-pro-preview, claude-sonnet-4-20250514, gpt-4o

# Workspace/project agent loop envelope. One loop plans, builds, renders,
# and repairs with inline tools. Zero means unbounded at the OmicsBase layer;
# provider/account limits still apply.
PROJECT_AGENT_ENABLED=true
PROJECT_AGENT_MAX_BUDGET_UNITS=0
PROJECT_AGENT_MAX_TOOL_CALLS=0
PROJECT_AGENT_MAX_MUTATIONS=0
PROJECT_AGENT_MAX_LLM_CALLS=0
PROJECT_AGENT_MAX_GENERATED_TOKENS=0
PROJECT_AGENT_MAX_RETRIEVED_CHARS=0
PROJECT_AGENT_MAX_INPUT_TOKENS=0
PROJECT_AGENT_MAX_TOTAL_TOKENS=0
# 0 uses the built-in default (48) steps per turn.
PROJECT_AGENT_MAX_STEPS=0
PROJECT_AGENT_MAX_OUTPUT_TOKENS=0
PROJECT_AGENT_MAX_TOOL_RETRIES=2

# Native Gemini SDK (google-genai); set to false to use the OpenAI-compatible
# endpoint. GEMINI_THINKING_BUDGET: 0 = provider default (auto thinking).
GEMINI_NATIVE=true
GEMINI_THINKING_BUDGET=0

# Database
DATABASE_URL=postgresql://omicsbase:omicsbase@localhost:5433/omicsbase

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=celery

# Local semantic retrieval for curated Bioconductor books. Exact lexical
# matching remains active for package/function names and is used as fallback.
BIOC_KNOWLEDGE_SEMANTIC_ENABLED=true
BIOC_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BIOC_KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
BIOC_KNOWLEDGE_SEMANTIC_CANDIDATE_LIMIT=64
BIOC_KNOWLEDGE_EMBEDDING_CACHE_DIR=

# Per-turn Notes agent safety budget. Notes gets a larger envelope than the
# Workspace agent because one request may inspect, search, run R, wait, and
# interpret. These are circuit breakers per turn, not notebook-wide limits.
NOTE_AGENT_MAX_STEPS=32
NOTE_AGENT_MAX_BUDGET_UNITS=32
NOTE_AGENT_MAX_TOOL_CALLS=48
NOTE_AGENT_MAX_MUTATIONS=8
NOTE_AGENT_MAX_LLM_CALLS=16
NOTE_AGENT_MAX_GENERATED_TOKENS=40000
NOTE_AGENT_MAX_RETRIEVED_CHARS=160000
NOTE_AGENT_MAX_GENERATED_CODE_CELLS=8

# Project storage
PROJECTS_DIR=./projects

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000
