# Copy to librechat/.env and supply local values. Never commit the real file.
HOST=0.0.0.0
PORT=3080
UID=1000
GID=1000
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
APP_TITLE=OmicsBase
CUSTOM_FOOTER=
# Generate independent values. See upstream LibreChat configuration requirements.
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
ADMIN_PANEL_SESSION_SECRET=
MEILI_MASTER_KEY=
OPENAI_API_KEY=
GOOGLE_KEY=
GROQ_API_KEY=
OPENROUTER_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
ZAI_API_KEY=
ZAI_BASE_URL=
ZENMUX_API_KEY=
ZENMUX_BASE_URL=
GMI_API_KEY=
GMI_BASE_URL=
BAI_API_KEY=
BAI_BASE_URL=
BAI_MODEL=
OPENCODE_API_KEY=
ALLOW_REGISTRATION=false
ENABLE_MCP=true
SCHEDULES_SINGLE_PROCESS=true
# Optional absolute path; otherwise deployment uses HOME/.openhands.
# OPENHANDS_STATE_DIR=
