# LLM Configuration
LLM_PROVIDER=anthropic          # anthropic, openai, qwen, gemini, openrouter, groq, grok, xai, ollama
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DASHSCOPE_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=gemini-3.1-pro-preview   # or claude-sonnet-4-20250514, gpt-4o, etc.

# Native Gemini SDK (google-genai); set to false to use the OpenAI-compatible
# endpoint. GEMINI_THINKING_BUDGET: 0 = provider default (auto thinking).
GEMINI_NATIVE=true
GEMINI_THINKING_BUDGET=0

# Database
DATABASE_URL=postgresql://omicsbase:omicsbase@localhost:5433/omicsbase

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=celery

# Project storage
PROJECTS_DIR=./projects

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000
