# Copy to librechat/.env and supply local values. Never commit the real file.
HOST=0.0.0.0
PORT=3080
UID=1000
GID=1000
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
APP_TITLE=OmicsBase
CUSTOM_FOOTER="OmicsBase | University of Turku | [Support](mailto:gtmulu@utu.fi)"
HELP_AND_FAQ_URL=https://omicsbase.utu.fi/docs/
# Generate independent values. See upstream LibreChat configuration requirements.
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
ADMIN_PANEL_SESSION_SECRET=
MEILI_MASTER_KEY=
OPENAI_API_KEY=
GOOGLE_KEY=
GROQ_API_KEY=
OPENROUTER_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
ZAI_API_KEY=
ZAI_BASE_URL=
ZENMUX_API_KEY=
ZENMUX_BASE_URL=
GMI_API_KEY=
GMI_BASE_URL=
BAI_API_KEY=
BAI_BASE_URL=
BAI_MODEL=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_ANTHROPIC_BASE_URL=https://api.apmix.ai
ALLOW_REGISTRATION=false
ENABLE_MCP=true
SCHEDULES_SINGLE_PROCESS=true
# Optional absolute path; otherwise deployment uses HOME/.openhands.
# OPENHANDS_STATE_DIR=

# Built with python3 scripts/build_engine.py
OMICSBASE_ENGINE_IMAGE=omicsbase-engine:dev

# Secret LibreChat and Reports share (launch tickets and the Reports cookie)
OMICSBASE_AUTH_SECRET=
# Secret LibreChat and the notes engine share (internal calls and the engine's project
# cookie). Optional: when empty the engine uses OMICSBASE_AUTH_SECRET. Set it whenever the
# engine runs on another machine, so that machine never holds the Reports secret.
OMICSBASE_ENGINE_SECRET=

# Reports on Roihu (deployment/roihu): the roihu-router admin secret (its admin-secret file)
# and the relay's TLS fingerprint (printed by the roihu-relay service at start).
ROIHU_ROUTER_SECRET=
ROIHU_RELAY_FINGERPRINT=

# Browser-facing origins. Set HTTPS URLs for public deployments.
OMICSBASE_OPENHANDS_PUBLIC_URL=http://localhost:3001
OMICSBASE_ENGINE_PUBLIC_URL=http://localhost:8001
OMICSBASE_WORKSPACE_SESSION_TTL=43200
OMICSBASE_LIBRECHAT_IMAGE=omicsbase-librechat:f9f1b2fb9
ADMIN_SSO_ENABLED=true

# Caddy hostnames used by the public deployment template.
OMICSBASE_APP_HOST=omicsbase.example.org
OMICSBASE_WORKSPACE_HOST=openhands.omicsbase.example.org
OMICSBASE_ADMIN_HOST=admin.omicsbase.example.org

# Combined analysis + OpenHands runtime; must be built before workspace launch.
OMICSBASE_RUNTIME_IMAGE=omicsbase-runtime:dev
