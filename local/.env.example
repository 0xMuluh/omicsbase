# install.sh writes .env from this file and fills in the secrets. To do it by hand:
# copy to .env and set each empty value to the output of `openssl rand -hex 32`.

# Version of the OmicsBase images (ghcr.io/0xmuluh/omicsbase-*).
OMICSBASE_VERSION=latest

# Your user and group id (`id -u`, `id -g`), so files in data/ stay yours.
UID=1000
GID=1000

# Secrets, generated once.
OMICSBASE_AUTH_SECRET=
OMICSBASE_ENGINE_SECRET=
MEILI_MASTER_KEY=

# Model keys: entered by each user in the browser. Put a real key here instead to share
# it with every account on this install.
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided

# --profile files: attached-file search. Embeddings are sent to OpenAI with this key.
# RAG_API_URL=http://rag_api:8000
# RAG_OPENAI_API_KEY=

# --profile admin: the admin panel's session secret.
# ADMIN_PANEL_SESSION_SECRET=
